# SwarmMemory backend configuration. Copy to `.env` (demo) — testnet values are
# generated into backend/.env.testnet by scripts/setup_testnet.sh.
# Never commit real keys. Private keys are read by the backend only.

# demo = simulated contract (no blockchain needed) | testnet = real NEAR testnet
SWARM_MODE=demo
# Use a separate database per mode; the API refuses to start on a DB holding the other mode's txs.
DATABASE_URL=postgresql+psycopg://localhost:5432/swarmmemory
# Derives per-agent API keys (HMAC). Change it.
SERVER_SECRET=change-me-to-a-long-random-string
# Where agents reach the SwarmMemory API (they only talk to it over HTTP)
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000

# Embeddings: local (deterministic, offline) or an OpenAI-compatible /embeddings endpoint
EMBEDDING_PROVIDER=local
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---- testnet mode only ----
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_EXPLORER_URL=https://testnet.nearblocks.io
NEAR_CONTRACT_ID=
NEAR_OWNER_ACCOUNT_ID=          # contract owner = reputation oracle (signs update_reputation)
NEAR_OWNER_PRIVATE_KEY=         # ed25519:...
NEAR_RESEARCHER_ACCOUNT_ID=
NEAR_RESEARCHER_PRIVATE_KEY=
NEAR_VERIFIER_ACCOUNT_ID=
NEAR_VERIFIER_PRIVATE_KEY=
NEAR_DEVELOPER_ACCOUNT_ID=
NEAR_DEVELOPER_PRIVATE_KEY=
# Alternatively load keys from near-cli legacy keychain files <account>.json
NEAR_CREDENTIALS_DIR=
